<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.snes9x.vr"
    android:installLocation="auto">

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Declared optional so the shell does not block launch with its
         "pick up your controllers" dialog; a gamepad works too. -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <!-- ROMs can live anywhere the player keeps them.  Scoped storage hides
         non-media files in folders the app does not own, so listing a ROM
         folder outside the app's own directory needs all-files access.  It is
         granted once, by the player in system settings, or over adb with
         "appops set" (see quest/README.md). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <!-- Lets the OpenXR loader find the runtime on Android 11 and newer. -->
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <application
        android:label="Snes9x VR"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <activity
            android:name="android.app.NativeActivity"
            android:label="Snes9x VR"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:exported="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">

            <meta-data android:name="android.app.lib_name" android:value="snes9xvr" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
